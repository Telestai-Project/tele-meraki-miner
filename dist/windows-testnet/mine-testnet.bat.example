@echo off
cd /d "%~dp0"
REM Replace the -P URL with the TestNet proxy Chief sent you.
REM Do not pass --work-timeout. Default is 180 seconds. Some 1.5.0 zips
REM reject --work-timeout 180 (they wrongly required 100000-1000000).
telemerakiminer.exe -U --farm-recheck 250 -P http://USER:PASS@HOST:18768/
if errorlevel 1 pause
